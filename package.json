{
  "name": "pkuml-website",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "pages:dev": "wrangler pages dev dist --d1 DB=pkuml-d1",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 migrations apply pkuml-d1 --local",
    "db:migrate:remote": "wrangler d1 migrations apply pkuml-d1 --remote",
    "user:create": "node scripts/create-user.mjs",
    "smoke:api": "node --experimental-strip-types --no-warnings scripts/smoke-api.mjs",
    "db:export:supabase": "node scripts/export-supabase.mjs",
    "db:import:d1": "node scripts/import-d1.mjs"
  },
  "dependencies": {
    "astro": "^7.2.1"
  },
  "devDependencies": {
    "vitest": "^4.1.10",
    "wrangler": "^4.128.0"
  }
}
