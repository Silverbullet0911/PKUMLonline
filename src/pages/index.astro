---
import BaseLayout from '../layouts/BaseLayout.astro'
import TeamStandingsTable from '../components/TeamStandingsTable.astro'
import FutureGames from '../components/FutureGames.astro'
import GameResult from '../components/GameResult.astro'
import { season, standings, news, schedule, teams } from '../lib/data'
import { compareUpcoming, compareFinished } from '../lib/schedule'
import { computeTeamBoard } from '../lib/standings'

// 首页默认显示 26-27 常规赛队伍榜
const regStage = season.stages.find((s) => s.name === '常规赛')
const regData = standings.stages.find((s) => s.name === '常规赛')
const teamNames = teams.teams.map((t) => t.name)
const teamRows = computeTeamBoard(regData?.teamBoard ?? [], regStage?.promoteRank ?? 6, teamNames)
const latestNews = [...news.items].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 2)
const upcomingGames = schedule.games.filter((g) => g.status === 'upcoming').sort(compareUpcoming).slice(0, 2)
const latestFinished = schedule.games.filter((g) => g.status === 'finished').sort(compareFinished)[0]
const base = import.meta.env.BASE_URL
---
<BaseLayout title="首页">
  <section class="intro">
    <h1>PKU M.LEAGUE</h1>
    <p>北京大学校内立直麻将团体赛官方网站 —— 赛程、积分、排名、规则与赛季档案一览。</p>
  </section>

  <h2 id="home-board-title">{season.season}赛季 常规赛队伍榜</h2>
  <div id="home-board">
    {
      teamRows.length > 0 ? (
        <TeamStandingsTable
          stage="常规赛"
          rows={teamRows}
          teams={teams.teams}
          totalGames={regStage?.totalGames ?? 48}
        />
      ) : (
        <p class="empty">本赛季尚未开始，排名将在第一场比赛后更新。</p>
      )
    }
  </div>

  <h2>最新赛果</h2>
  <div id="home-result">
    {
      latestFinished ? (
        <GameResult game={latestFinished} />
      ) : (
        <p class="empty">暂无赛果。</p>
      )
    }
  </div>

  <h2>最近赛程</h2>
  <div id="home-schedule">
    {
      upcomingGames.length > 0 ? (
        <FutureGames games={upcomingGames} showHeading={false} />
      ) : (
        <p class="empty">暂无未来赛程。</p>
      )
    }
  </div>

  <h2>最新公告</h2>
  <div id="home-news">
    {
      latestNews.length > 0 ? (
        <ul class="news-list">
          {latestNews.map((n) => <li><time>{n.date}</time><a href={`${base}news/detail?id=${encodeURIComponent(n.id ?? n.title)}`}>{n.title}</a></li>)}
        </ul>
      ) : (
        <p class="empty">暂无公告。</p>
      )
    }
  </div>
  <script>
    import { supabase } from '../lib/supabase'
    import { season, teams } from '../lib/data'
    import { compareUpcoming, compareFinished } from '../lib/schedule'
    import { mapDbGame, splitGames } from '../lib/renderSchedule'
    import { teamStyle, esc, renderTeamTable, standingsAsOf } from '../lib/renderStandings'
    import { aggregateTeamBoard } from '../lib/aggregate'
    import { computeTeamBoard } from '../lib/standings'

    const base = import.meta.env.BASE_URL
    const teamNames = teams.teams.map((t) => t.name)

    ;(async () => {
      const { data, error } = await supabase.from('games').select('*').order('date', { ascending: true })
      if (error || !data || data.length === 0) return // 保留静态回退
      const games = (data as any[]).filter((g) => g.season === season.season).map(mapDbGame)
      const { upcoming, finished } = splitGames(games)

      // 最新赛果
      const latest = [...finished].sort(compareFinished)[0]
      if (latest) {
        const box = document.getElementById('home-result')
        if (box) {
          box.innerHTML =
            `<section class="game-card">` +
            `<h2>${esc(latest.stage)}${latest.round ? ' ' + esc(latest.round) : ''} · ${esc(latest.date)}</h2>` +
            `<div class="game-players">` +
            latest.seats.map((s) =>
              `<div class="game-player" style="${teamStyle(s.team, teams.teams)}">` +
              `<span class="gp-team">${esc(String(s.team ?? ''))}</span><span class="gp-seat">${esc(String(s.seat ?? ''))}</span>` +
              `<span class="gp-name">${s.name ? esc(s.name) : ''}</span>` +
              `<span class="gp-pts">${esc(String(s.points ?? 0))}</span><span class="gp-rank">${esc(String(s.rank ?? ''))}位</span>` +
              `</div>`).join('') +
            `</div></section>`
        }
      }

      // 最近赛程（最多 2 场）
      const ups = [...upcoming]
        .sort(compareUpcoming)
        .slice(0, 2)
      if (ups.length > 0) {
        const box = document.getElementById('home-schedule')
        if (box) {
          box.innerHTML = ups.map((g) =>
            `<div class="future-row">` +
            `<div class="future-meta">` +
            `<div><span class="fm-date">${esc(g.date)}</span><span class="fm-rest"> · ${esc(g.stage)}${g.round ? ' ' + esc(g.round) : ''}</span></div>` +
            `${(g.time || g.liveStatus) ? `<div class="fm-subrow"><div class="fm-time">${g.time ? esc(g.time) : ''}</div>${g.liveStatus ? `<span class="fm-live">${esc(g.liveStatus)}</span>` : ''}</div>` : ''}` +
            `</div>` +
            `<div class="future-seats">` +
            g.seats.map((s) =>
              `<div class="future-seat" style="${teamStyle(s.team, teams.teams)}">` +
              `<span class="fs-seat">${esc(String(s.seat ?? ''))}</span><span class="fs-team">${esc(String(s.team ?? ''))}</span>` +
              `${s.name ? `<span class="fs-player">${esc(s.name)}</span>` : ''}` +
              `</div>`).join('') +
            `</div></div>`).join('')
        }
      }
    })()

    // 最新公告（DB 优先，静态回退由 SSR 承担）
    ;(async () => {
      const { data: anns } = await supabase
        .from('announcements').select('*').order('date', { ascending: false }).limit(2)
      if (!anns || anns.length === 0) return
      const box = document.getElementById('home-news')
      if (box) {
        box.innerHTML =
          `<ul class="news-list">` +
          anns.map((a) => `<li><time>${esc(a.date)}</time><a href="${base}news/detail?id=${encodeURIComponent(a.id)}">${esc(a.title)}</a></li>`).join('') +
          `</ul>`
      }
    })()

    // 首页队伍榜（DB 现算 26-27 常规赛，静态回退由 SSR 承担）
    ;(async () => {
      const { data: fin, error: finErr } = await supabase.from('games').select('*').eq('status', 'finished')
      if (finErr || !fin || fin.length === 0) return
      const finished = (fin as any[]).filter((g) => g.season === season.season).map(mapDbGame)
      const regGames = finished.filter((g) => g.stage === '常规赛')
      if (regGames.length === 0) return
      const stage = season.stages.find((s) => s.name === '常规赛')
      const board = computeTeamBoard(
        aggregateTeamBoard(regGames, undefined, teamNames),
        stage?.promoteRank ?? 6,
        teamNames,
      )
      const box = document.getElementById('home-board')
      if (box) {
        box.innerHTML =
          renderTeamTable('常规赛', board, teams.teams, stage?.totalGames ?? 48) +
          `<p class="as-of as-of-team">${standingsAsOf(regGames) ?? ''}</p>`
      }
    })()
  </script>
</BaseLayout>
