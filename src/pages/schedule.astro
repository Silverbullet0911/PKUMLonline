---
import BaseLayout from '../layouts/BaseLayout.astro'
import StageTabs from '../components/StageTabs.astro'
import FutureGames from '../components/FutureGames.astro'
import GameResult from '../components/GameResult.astro'
import MonthIndex from '../components/MonthIndex.astro'
import { schedule } from '../lib/data'
import { groupByMonth, roundNum } from '../lib/schedule'

const upcoming = schedule.games.filter((g) => g.status === 'upcoming')
const finished = schedule.games.filter((g) => g.status === 'finished')
const finishedGroups = groupByMonth(finished, {
  order: 'desc',
  within: (a, b) => roundNum(b) - roundNum(a),
})
const finishedMonths = finishedGroups.map((mg) => mg.month)
---
<BaseLayout title="赛程与赛果">
  <h1>赛程与赛果</h1>

  <StageTabs stages={[{ name: '赛程' }, { name: '赛果' }]} />

  <section id="stage-0" class="stage-panel active">
    {
      upcoming.length === 0 ? (
        <p class="empty">暂无赛程。</p>
      ) : (
        <FutureGames games={upcoming} showGuide prefix="sch" />
      )
    }
  </section>

  <section id="stage-1" class="stage-panel">
    {
      finished.length === 0 ? (
        <p class="empty">暂无赛果。</p>
      ) : (
        <div class="month-layout">
          <MonthIndex months={finishedMonths} prefix="res" />
          <div>
            {
              finishedGroups.map((mg) => (
                <section id={`res-${mg.month}`} class="month-group">
                  <h2>{mg.month}</h2>
                  {mg.games.map((g) => <GameResult game={g} />)}
                </section>
              ))
            }
          </div>
        </div>
      )
    }
  </section>

  <button class="nav-toggle" aria-label="导引">☰</button>
  <script>
    document.querySelectorAll('.stage-tab').forEach((tab) => {
      tab.addEventListener('click', () => {
        document.querySelectorAll('.stage-tab').forEach((t) => t.classList.remove('active'))
        document.querySelectorAll('.stage-panel').forEach((p) => p.classList.remove('active'))
        tab.classList.add('active')
        document.getElementById(tab.dataset.target ?? '')?.classList.add('active')
      })
    })
    document.querySelectorAll('.az-link').forEach((link) => {
      link.addEventListener('click', () => {
        document.querySelectorAll('.az-link').forEach((l) => l.classList.remove('active'))
        link.classList.add('active')
      })
    })
    document.querySelector('.nav-toggle')?.addEventListener('click', () => {
      document.querySelector('.stage-panel.active .az-nav')?.classList.toggle('open')
    })
  </script>
  <script>
    import { supabase } from '../lib/supabase'
    import { season } from '../lib/data'
    import { mapDbGame, splitGames, monthGroupsOf, teamStyle, escHtml } from '../lib/renderSchedule'

    ;(async () => {
      const base = import.meta.env.BASE_URL
      const { data, error } = await supabase.from('games').select('*').order('date', { ascending: true })
      if (error || !data || data.length === 0) return
      const games = (data as any[]).filter((g: any) => g.season === season.season).map(mapDbGame)
      const { upcoming, finished } = splitGames(games)

      const up = document.querySelector('#stage-0')
      if (up) {
        if (upcoming.length === 0) {
          up.innerHTML = '<p class="empty">暂无赛程。</p>'
        } else {
          const groups = monthGroupsOf(upcoming, 'asc')
          up.innerHTML = groups.map((mg) => `
            <section id="sch-${mg.month}" class="month-group">
              <h2>${escHtml(mg.month)}</h2>
              ${mg.games.map((g) => `
                <div class="future-row">
                  <div class="future-meta">
                    <div><span class="fm-date">${escHtml(g.date)}</span><span class="fm-rest"> · ${escHtml(g.stage)}${g.round ? ' ' + escHtml(g.round) : ''}</span></div>
                    ${g.time ? `<div class="fm-time">${escHtml(g.time)}</div>` : ''}
                    ${g.liveStatus ? `<div class="fm-time">${escHtml(g.liveStatus)}</div>` : ''}
                  </div>
                  <div class="future-seats">
                    ${g.seats.map((s) => `
                      <div class="future-seat" style="${teamStyle(s.team)}">
                        <span class="fs-seat">${escHtml(String(s.seat ?? ''))}</span>
                        <span class="fs-team">${escHtml(String(s.team ?? ''))}</span>
                        ${s.name ? `<span class="fs-player">${escHtml(s.name)}</span>` : ''}
                      </div>`).join('')}
                  </div>
                </div>`).join('')}
            </section>`).join('')
        }
      }

      const res = document.querySelector('#stage-1')
      if (res) {
        if (finished.length === 0) {
          res.innerHTML = '<p class="empty">暂无赛果。</p>'
        } else {
          const groups = monthGroupsOf(finished, 'desc')
          res.innerHTML = groups.map((mg) => `
            <section id="res-${mg.month}" class="month-group">
              <h2>${escHtml(mg.month)}</h2>
              ${mg.games.map((g) => `
                <a class="game-card game-card-link" style="text-decoration:none;color:inherit;display:block" href="${escHtml(base)}match/?id=${encodeURIComponent(g.id)}">
                  <h2>${escHtml(g.stage)}${g.round ? ' ' + escHtml(g.round) : ''} · ${escHtml(g.date)}</h2>
                  <div class="game-players">
                    ${g.seats.map((s) => `
                      <div class="game-player" style="${teamStyle(s.team)}">
                        <span class="gp-team">${escHtml(String(s.team ?? ''))}</span>
                        <span class="gp-seat">${escHtml(String(s.seat ?? ''))}</span>
                        <span class="gp-name">${s.name ? escHtml(s.name) : ''}</span>
                        <span class="gp-pts">${escHtml(String(s.points ?? 0))}</span>
                        <span class="gp-rank">${escHtml(String(s.rank ?? ''))}位</span>
                      </div>`).join('')}
                  </div>
                </a>`).join('')}
            </section>`).join('')
        }
      }
    })()
  </script>
</BaseLayout>
