---
import BaseLayout from '../layouts/BaseLayout.astro'
import FutureGames from '../components/FutureGames.astro'
import { schedule, teams, teamText } from '../lib/data'
import { formatScore } from '../lib/standings'

const colorOf = (name: string) => teams.teams.find((t) => t.name === name)?.color ?? '#9ca3af'
const ts = (name: string) => `background:${colorOf(name)};color:${teamText(name)}`

const upcoming = schedule.games.filter((g) => g.status === 'upcoming')
const finished = schedule.games.filter((g) => g.status === 'finished')
---
<BaseLayout title="赛程与结果">
  <h1>赛程与结果</h1>

  <h2>未来赛程</h2>
  {
    upcoming.length === 0 ? (
      <p class="empty">暂无未来赛程。</p>
    ) : (
      <FutureGames games={upcoming} />
    )
  }

  <h2>已结束对局</h2>
  {
    finished.length === 0 ? (
      <p class="empty">暂无已结束对局。</p>
    ) : (
      finished.map((g) => (
        <section class="game-card">
          <h2>{g.stage}{g.round ? ` ${g.round}` : ''} · {g.date}</h2>
          <div class="game-players">
            {
              g.seats.map((s) => (
                <div class="game-player" style={ts(s.team)}>
                  <span class="gp-team">{s.team}</span>
                  <span class="gp-seat">{s.seat}</span>
                  <span class="gp-name">{s.name}</span>
                  <span class="gp-pts">{formatScore(s.points ?? 0)}</span>
                  <span class="gp-rank">{s.rank}位</span>
                </div>
              ))
            }
          </div>
          <p>
            {g.replayUrl && <a href={g.replayUrl} target="_blank" rel="noopener">牌谱</a>}
            {g.videoUrl && <a href={g.videoUrl} target="_blank" rel="noopener">录像</a>}
          </p>
        </section>
      ))
    )
  }
</BaseLayout>
