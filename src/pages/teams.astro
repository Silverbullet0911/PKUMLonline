---
import BaseLayout from '../layouts/BaseLayout.astro'
import { teams, roster, players } from '../lib/data'

const playersByName = new Map(players.players.map((p) => [p.name, p]))
const current = new Set(roster.teams.flatMap((t) => t.roster))
const alumni = players.players
  .filter((p) => !current.has(p.name))
  .sort((a, b) => a.name.localeCompare(b.name, 'zh'))

const formatName = (name: string) =>
  /^[一-鿿]{2}$/.test(name) ? name[0] + ' ' + name[1] : name

const base = import.meta.env.BASE_URL

const lastTeamColor = (p: { history: { team: string | null }[] }) => {
  const last = p.history[p.history.length - 1]
  if (!last?.team) return null
  return teams.teams.find(t => t.name === last.team)?.color ?? null
}
---
<BaseLayout title="队伍与选手">
  <h1>队伍与选手</h1>

  <h2>当前赛季（{roster.season}）队伍</h2>
  {
    teams.teams.map((t) => {
      const r = roster.teams.find((rt) => rt.name === t.name)
      return (
        <section class="team-card">
          <h2><span class="team-dot" style={`background:${t.color}`}></span>{t.name}</h2>
          <div class="player-grid">
            {
              r?.roster.map((name) => {
                return (
                  <a class="player-chip" href={`${base}archive#player-${encodeURIComponent(name)}`} style={`--tc:${t.color}`}>
                    <span class="player-name">{formatName(name)}</span>
                    {name === r.captain && <span class="captain-tag">队长</span>}
                  </a>
                )
              })
            }
          </div>
        </section>
      )
    })
  }

  <h2>往届选手</h2>
  {
    alumni.length === 0 ? (
      <p class="empty">暂无往届选手数据。</p>
    ) : (
      <div class="alumni-grid">
        {alumni.map((p) => (
          <a class="alumni-chip" href={`${base}archive#player-${encodeURIComponent(p.name)}`} style={lastTeamColor(p) ? `--tc:${lastTeamColor(p)}` : ''}>{p.name}</a>
        ))}
      </div>
    )
  }
</BaseLayout>
