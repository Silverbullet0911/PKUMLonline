---
import BaseLayout from '../../../../layouts/BaseLayout.astro'
import AdminShell from '../../../../components/admin/AdminShell.astro'
---
<BaseLayout title="查看结果">
  <AdminShell>
    <h1>查看结果</h1>
    <p id="res-err" class="admin-err"></p>
    <div id="res-root">
      <p class="empty">加载中…</p>
    </div>
  </AdminShell>
  <style>
    .res-seats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; margin: 12px 0; }
    .res-seat { border-radius: 8px; padding: 8px 10px; color: #fff; font-weight: 700; }
    .res-seat .s { font-size: 12px; opacity: .8; }
    .res-seat .t { font-size: 15px; }
    .res-seat .p { font-size: 13px; font-weight: 400; opacity: .9; }
    .res-table input { width: 90px; text-align: right; font-variant-numeric: tabular-nums; }
    .res-sum { font-size: 14px; margin: 10px 0; }
    .res-sum.bad { color: #b91c1c; font-weight: 700; }
    .res-actions { display: flex; gap: 10px; margin: 14px 0; }
    .res-actions button { padding: 8px 18px; border-radius: 8px; border: 1px solid var(--line); background: var(--card); cursor: pointer; font-size: 14px; }
    .res-actions button.primary { background: var(--accent); color: #fff; border-color: var(--accent); }
    @media (max-width: 720px) { .res-seats { grid-template-columns: repeat(2, 1fr); } }
  </style>
  <script>
    import { supabase } from '../../../../lib/supabase'
    import { replayGame } from '../../../../lib/replay'
    import { rawScoreOf, rankPointsForScores, competitionRanks } from '../../../../lib/aggregate'
    import teamsRaw from '../../../../data/teams.json'

    const base = import.meta.env.BASE_URL
    const errEl = document.getElementById('res-err')!
    const root = document.getElementById('res-root')!
    const showErr = (m: string) => { errEl.textContent = m }
    const clearErr = () => { errEl.textContent = '' }

    const params = new URLSearchParams(location.search)
    const gameId = params.get('id')
    if (!gameId) {
      root.innerHTML = '<p class="empty">缺少对局 id（?id=…）</p>'
    }

    function el(tag: string, cls = '', text = ''): HTMLElement {
      const n = document.createElement(tag)
      if (cls) n.className = cls
      if (text) n.textContent = text
      return n
    }

    const teamColor = (name: string) => teamsRaw.teams.find((t: any) => t.name === name)?.color ?? '#9ca3af'

    let game: any = null
    let role: string | null = null
    let finalScores: number[] = []

    async function loadRounds(): Promise<any[]> {
      const { data } = await supabase.from('rounds').select('*').eq('game_id', gameId).order('order', { ascending: true })
      return data ?? []
    }

    async function load() {
      if (!gameId) return
      const { data: { session } } = await supabase.auth.getSession()
      if (!session) { location.href = base + 'admin/login/'; return }
      const { data: profile } = await supabase.from('profiles').select('role').eq('id', session.user.id).single()
      role = profile?.role ?? null
      if (role !== 'admin' && role !== 'referee') { location.href = base + 'admin/'; return }

      const { data: g, error } = await supabase.from('games').select('*').eq('id', gameId).single()
      if (error || !g) { showErr('加载对局失败：' + (error?.message ?? 'not found')); root.innerHTML = '<p class="empty">对局不存在。</p>'; return }
      game = g
      if (g.status === 'finished') {
        root.innerHTML = ''
        root.appendChild(el('p', 'sel-info', '该半庄已提交为赛果。'))
        const link = el('a', '', '查看赛果详情')
        link.href = base + 'match/?id=' + encodeURIComponent(gameId)
        root.appendChild(link)
        return
      }
      render()
    }

    function render() {
      clearErr()
      root.innerHTML = ''
      const seats = game.seats ?? []

      // 座位卡
      const grid = el('div', 'res-seats')
      seats.forEach((s: any) => {
        const card = el('div', 'res-seat')
        card.style.background = teamColor(s.team)
        card.append(el('div', 's', s.seat), el('div', 't', s.team), el('div', 'p', s.player ?? ''))
        grid.appendChild(card)
      })
      root.appendChild(grid)

      renderAsync()
    }

    async function renderAsync() {
      if (!gameId) return
      const rs = await loadRounds()
      const rounds = rs.map((r: any) => ({
        order: r.order,
        win_type: r.win_type,
        riichi: r.riichi ?? [false, false, false, false],
        ron_winner: r.ron_winner,
        ron_loser: r.ron_loser,
        ron_points: r.ron_points,
        tsumo_winner: r.tsumo_winner,
        tsumo_points: r.tsumo_points,
        tenpai: r.tenpai,
        override: r.override,
      }))
      const rep = replayGame(rounds)
      finalScores = [...rep.current.scores]
      renderTable(finalScores)
    }

    function renderTable(initial: number[]) {
      const seats = game.seats ?? []
      const ptInputs: HTMLInputElement[] = []
      const rankSelects: HTMLSelectElement[] = []
      const penInputs: HTMLInputElement[] = []
      // 初始分数（回放结果，只读）与自动 pt / 位次
      const scoreArr = [...initial]
      const autoRp = rankPointsForScores(scoreArr)
      const autoPt = scoreArr.map((v, i) => Math.round((rawScoreOf(v) + autoRp[i]) * 10) / 10)
      const autoRanks = competitionRanks(scoreArr)

      const box = el('div', 'table-wrap')
      const table = el('table')
      const thead = el('thead')
      const htr = el('tr')
      ;['座位', '队伍', '选手', 'pt(可改)', '素点', '顺位点', '最终分数', '位次(可改)', '判罚(可改)'].forEach((h) => htr.appendChild(el('th', '', h)))
      thead.appendChild(htr)
      table.appendChild(thead)
      const tbody = el('tbody')

      function refresh() {
        const pts = ptInputs.map((x) => Number(x.value))
        const rows = tbody.querySelectorAll('tr')
        rows.forEach((tr, i) => {
          const tds = tr.querySelectorAll('td')
          const raw = rawScoreOf(scoreArr[i])
          const rp = Math.round((pts[i] - raw) * 10) / 10
          tds[4].textContent = String(raw)
          tds[5].textContent = String(rp)
          tds[6].textContent = String(scoreArr[i])
        })
        const sum = pts.reduce((a, b) => a + (Number.isFinite(b) ? b : 0), 0)
        sumEl.textContent = `pt 合计：${sum}（自动结算通常为 0；判罚另计，不计入素点/场次 pt）`
        sumEl.classList.toggle('bad', Math.abs(sum) > 0.001)
      }

      seats.forEach((s: any, i: number) => {
        const tr = el('tr')
        tr.appendChild(el('td', '', s.seat))
        tr.appendChild(el('td', '', s.team))
        tr.appendChild(el('td', '', s.player ?? ''))
        const tdPt = el('td')
        const ptInput = document.createElement('input')
        ptInput.type = 'number'
        ptInput.step = '0.1'
        ptInput.value = String(autoPt[i])
        ptInput.addEventListener('input', refresh)
        ptInputs.push(ptInput)
        tdPt.appendChild(ptInput)
        tr.appendChild(tdPt)
        tr.appendChild(el('td', 'num', ''))
        tr.appendChild(el('td', 'num', ''))
        tr.appendChild(el('td', 'num', ''))
        const tdRank = el('td')
        const rankSel = document.createElement('select')
        for (let r = 1; r <= 4; r++) {
          const opt = document.createElement('option')
          opt.value = String(r)
          opt.textContent = r + '位'
          rankSel.appendChild(opt)
        }
        rankSel.value = String(autoRanks[i])
        rankSelects.push(rankSel)
        tdRank.appendChild(rankSel)
        tr.appendChild(tdRank)
        const tdPen = el('td')
        const penInput = document.createElement('input')
        penInput.type = 'number'
        penInput.step = '0.1'
        penInput.value = '0'
        penInputs.push(penInput)
        tdPen.appendChild(penInput)
        tr.appendChild(tdPen)
        tbody.appendChild(tr)
      })
      table.appendChild(tbody)
      box.appendChild(table)
      root.appendChild(box)

      const sumEl = el('p', 'res-sum', '')
      root.appendChild(sumEl)

      const actions = el('div', 'res-actions')
      const backBtn = el('button', '', '返回录入')
      backBtn.addEventListener('click', () => {
        location.href = base + 'admin/match/?id=' + encodeURIComponent(gameId)
      })
      const submitBtn = el('button', 'primary', '提交为赛果')
      submitBtn.addEventListener('click', () => submit(submitBtn))
      actions.append(backBtn, submitBtn)
      root.appendChild(actions)

      refresh()
    }

    async function submit(btn: HTMLButtonElement) {
      if (!gameId) return
      clearErr()
      const inputs = Array.from(root.querySelectorAll('input[type=number]')) as HTMLInputElement[]
      const ptValues: number[] = []
      const penValues: number[] = []
      // 输入顺序：每行先 pt 后判罚
      for (let k = 0; k < inputs.length; k += 2) ptValues.push(Number(inputs[k].value))
      for (let k = 1; k < inputs.length; k += 2) penValues.push(Number(inputs[k].value))
      if (ptValues.some((x) => !Number.isFinite(x)) || penValues.some((x) => !Number.isFinite(x))) {
        showErr('pt 与判罚须为数字')
        return
      }
      const rankValues = Array.from(root.querySelectorAll('select')) as HTMLSelectElement[]
      const ranks = rankValues.map((x) => Number(x.value))
      // 弃置未完成草稿（比赛按已录小局结算）
      await supabase.from('rounds').delete().eq('game_id', gameId).is('win_type', null)
      const seats = (game.seats ?? []).map((s: any, i: number) => ({
        seat: s.seat,
        team: s.team,
        player: s.player,
        rank: ranks[i],
        points: finalScores[i],
        pt: ptValues[i],
        penalty: penValues[i],
      }))
      btn.disabled = true
      btn.textContent = '提交中…'
      const { error } = await supabase.rpc('finish_game', { p_game_id: gameId, p_seats: seats })
      if (error) { showErr('提交失败：' + error.message); btn.disabled = false; btn.textContent = '提交为赛果'; return }
      location.href = base + 'match/?id=' + encodeURIComponent(gameId)
    }

    load()
  </script>
</BaseLayout>
