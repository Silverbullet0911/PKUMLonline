---
import BaseLayout from '../layouts/BaseLayout.astro'
import { news } from '../lib/data'
---
<BaseLayout title="公告">
  <h1>公告</h1>
  {
    news.items.length === 0 ? (
      <p class="empty">暂无公告。</p>
    ) : (
      news.items.map((n) => (
        <section class="charter-block">
          <h2>{n.title}</h2>
          <p class="news-meta"><time>{n.date}</time> · {n.category}</p>
          <p>{n.body}</p>
        </section>
      ))
    )
  }
</BaseLayout>
