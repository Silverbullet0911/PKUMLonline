---
import BaseLayout from '../layouts/BaseLayout.astro'
import { news } from '../lib/data'

const base = import.meta.env.BASE_URL
const sorted = [...news.items].sort((a, b) => b.date.localeCompare(a.date))
---
<BaseLayout title="公告">
  <h1>公告</h1>
  <div id="news-list">
    {
      sorted.length === 0 ? (
        <p class="empty">暂无公告。</p>
      ) : (
        <ul class="news-list">
          {sorted.map((n) => (
            <li>
              <time>{n.date}</time>
              <a href={`${base}news/detail?id=${encodeURIComponent(n.id ?? n.title)}`}>{n.title}</a>
            </li>
          ))}
        </ul>
      )
    }
  </div>
  <script>
    import { supabase } from '../lib/supabase'
    ;(async () => {
      const { data, error } = await supabase
        .from('announcements').select('*').order('date', { ascending: false })
      if (error || !data || data.length === 0) return // 回退到静态内容
      const box = document.getElementById('news-list')
      if (!box) return
      box.innerHTML = ''
      const ul = document.createElement('ul')
      ul.className = 'news-list'
      for (const a of data) {
        const li = document.createElement('li')
        const time = document.createElement('time')
        time.textContent = a.date
        const link = document.createElement('a')
        link.href = `${import.meta.env.BASE_URL}news/detail?id=${encodeURIComponent(a.id)}`
        link.textContent = a.title
        li.append(time, link)
        ul.appendChild(li)
      }
      box.appendChild(ul)
    })()
  </script>
</BaseLayout>
