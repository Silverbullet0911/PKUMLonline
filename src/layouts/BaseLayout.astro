---
import '../styles/global.css'

interface Props {
  title: string
}

const { title } = Astro.props

const base = import.meta.env.BASE_URL

const nav = [
  { href: '/', label: '首页' },
  { href: '/news', label: '公告' },
  { href: '/schedule', label: '赛程与结果' },
  { href: '/standings', label: '积分排名' },
  { href: '/teams', label: '队伍与选手' },
  { href: '/rules', label: '赛事章程' },
  { href: '/archive', label: '选手档案' },
]

const pathname = Astro.url.pathname
const route = base !== '/' && pathname.startsWith(base)
  ? pathname.slice(base.length - 1)
  : pathname
---
<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | PKU M.LEAGUE</title>
  </head>
  <body>
    <header class="site-header">
      <a class="site-brand" href={base}>
        <img class="site-logo" src={`${base}PLG标志平面.png`} alt="PLG" />
        <span class="site-title">PKU M.LEAGUE</span>
      </a>
      <nav class="site-nav">
        {
          nav.map((item) => {
            const active = item.href === '/' ? route === '/' : route.startsWith(item.href)
            const href = item.href === '/' ? base : `${base}${item.href.slice(1)}`
            return (
              <a class:list={['nav-link', { active }]} href={href}>
                {item.label}
              </a>
            )
          })
        }
      </nav>
    </header>
    <main class="site-main">
      <slot />
    </main>
    <footer class="site-footer">PKU M.LEAGUE 官方网站 · 数据仅供选手内部参考</footer>
  </body>
</html>
