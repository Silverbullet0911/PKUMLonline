---
interface Props {
  stages: { name: string }[]
  active?: number
}

const { stages, active = 0 } = Astro.props
---
<div class="stage-tabs" role="tablist">
  {
    stages.map((s, i) => (
      <button class:list={['stage-tab', { active: i === active }]} data-target={`stage-${i}`}>{s.name}</button>
    ))
  }
</div>
