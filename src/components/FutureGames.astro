---
import MonthIndex from './MonthIndex.astro'
import { teams, teamText } from '../lib/data'
import { groupByMonth, compareUpcoming } from '../lib/schedule'
import type { Game } from '../lib/types'

interface Props {
  games: Game[]
  showGuide?: boolean
  showHeading?: boolean
  prefix?: string
}

const { games, showGuide = false, showHeading = true, prefix = 'sch' } = Astro.props
const groups = groupByMonth(games, { order: 'asc', within: compareUpcoming })
const months = groups.map((g) => g.month)

const colorOf = (name: string) => teams.teams.find((t) => t.name === name)?.color ?? '#9ca3af'
const ts = (name: string) => `background:${colorOf(name)};color:${teamText(name)}`
---
<div class:list={['future-layout', { 'has-guide': showGuide }]}>
  {showGuide && <MonthIndex months={months} prefix={prefix} />}
  <div class="month-groups">
    {
      groups.map((mg) => (
        <section id={`${prefix}-${mg.month}`} class="month-group">
          {showHeading && <h2>{mg.month}</h2>}
          {
            mg.games.map((g) => (
              <div class="future-row">
                <div class="future-meta">
                  <div><span class="fm-date">{g.date}</span><span class="fm-rest"> · {g.stage}{g.round ? ` ${g.round}` : ''}</span></div>
                  {(g.time || g.liveStatus) && (
                    <div class="fm-subrow">
                      <div class="fm-time">{g.time ?? ''}</div>
                      {g.liveStatus && <span class="fm-live">{g.liveStatus}</span>}
                    </div>
                  )}
                </div>
                <div class="future-seats">
                  {
                    g.seats.map((s) => (
                      <div class="future-seat" style={ts(s.team)}>
                        <span class="fs-seat">{s.seat}</span>
                        <span class="fs-team">{s.team}</span>
                        {s.name && <span class="fs-player">{s.name}</span>}
                      </div>
                    ))
                  }
                </div>
              </div>
            ))
          }
        </section>
      ))
    }
  </div>
</div>
